# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
*.egg-info/

# Models
models/
*.pt
*.bin
*.safetensors
*.joblib
# Data (video files, large chat JSONs)
data/training/*.mp4
data/training/*.wav
data/testing/*.mp4
data/testing/*.wav
# Subdirectories too: the single-level rules above do not match
# data/testing/ironmouse_4h/video.mp4, which is exactly how a 5.5GB VOD ended up
# committed and had to be stripped from history before the repo could be pushed.
data/**/*.mp4
data/**/*.wav
data/**/*.mkv
data/**/*.ts
data/training/*.part*
data/testing/*.part*
data/**/*.part*
data/**/*.ytdl
data/**/chat.json

# Output
output/
clips/
uploads/

# Environment
.env

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Temp
/tmp/
*.log

# Frontend (SvelteKit)
frontend/node_modules/
frontend/build/
frontend/.svelte-kit/
frontend/package

# Deno
server/node_modules/
*.waveform.json

# Native binaries + models — fetched by scripts/fetch-native.sh (CI + dev)
native/
dist/
